<mxfile host="drawio" agent="signal-relay"><diagram id="d" name="Build and update pipeline"><mxGraphModel grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1020" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/>
<mxCell id="title" value="&lt;b&gt;How the image is built and updated&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot; color=&quot;#555555&quot;&gt;Every input is verified against a pinned value; any failed check stops the build&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=22;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1200" height="60" as="geometry"/></mxCell>
<mxCell id="inh" value="&lt;b&gt;Inputs&lt;/b&gt; &lt;font style=&quot;font-size:11px&quot;&gt;(downloaded at build time)&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="135" width="300" height="30" as="geometry"/></mxCell>
<mxCell id="i1" value="&lt;b&gt;signal-cli release&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;GitHub · AsamK&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="40" y="175" width="270" height="75" as="geometry"/></mxCell>
<mxCell id="i2" value="&lt;b&gt;libsignal&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Signal's build artifacts&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="40" y="275" width="270" height="75" as="geometry"/></mxCell>
<mxCell id="i3" value="&lt;b&gt;Wire runtime 6.3.0&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Maven Central · Block&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="40" y="375" width="270" height="75" as="geometry"/></mxCell>
<mxCell id="i4" value="&lt;b&gt;OpenJDK 25, qrencode&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Debian packages (signed)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="40" y="475" width="270" height="75" as="geometry"/></mxCell>
<mxCell id="i5" value="&lt;b&gt;Base images&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;debian:trixie-slim · distroless cc-debian13&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="40" y="575" width="270" height="75" as="geometry"/></mxCell>
<mxCell id="chk" value="&lt;b&gt;Checks&lt;/b&gt; &lt;font style=&quot;font-size:11px&quot;&gt;(pinned in the Dockerfile)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#eef3f8;strokeColor=#6c8ebf;verticalAlign=top;spacingTop=8;fontSize=14;arcSize=3;" vertex="1" parent="1"><mxGeometry x="400" y="120" width="470" height="560" as="geometry"/></mxCell>
<mxCell id="c1" value="&lt;font style=&quot;font-size:11px&quot;&gt;GPG signature from AsamK's pinned key&lt;br&gt;+ SHA-256 = GitHub's published digest&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="430" y="182" width="410" height="60" as="geometry"/></mxCell>
<mxCell id="ei0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeWidth=2;fontSize=12;labelBackgroundColor=#ffffff;strokeColor=#6c8ebf;" edge="1" parent="1" source="i1" target="c1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="c2" value="&lt;font style=&quot;font-size:11px&quot;&gt;&lt;b&gt;byte-identical&lt;/b&gt; to Signal's release&lt;br&gt;(LIBSIGNAL_SO_SHA256)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="430" y="282" width="410" height="60" as="geometry"/></mxCell>
<mxCell id="ei1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeWidth=2;fontSize=12;labelBackgroundColor=#ffffff;strokeColor=#6c8ebf;" edge="1" parent="1" source="i2" target="c2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="c3" value="&lt;font style=&quot;font-size:11px&quot;&gt;GPG signature from Block's pinned key&lt;br&gt;+ pinned SHA-256 (fixes CVE-2026-45799)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="430" y="382" width="410" height="60" as="geometry"/></mxCell>
<mxCell id="ei2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeWidth=2;fontSize=12;labelBackgroundColor=#ffffff;strokeColor=#6c8ebf;" edge="1" parent="1" source="i3" target="c3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="c4" value="&lt;font style=&quot;font-size:11px&quot;&gt;apt verifies Debian's signatures&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="430" y="482" width="410" height="60" as="geometry"/></mxCell>
<mxCell id="ei3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeWidth=2;fontSize=12;labelBackgroundColor=#ffffff;strokeColor=#6c8ebf;" edge="1" parent="1" source="i4" target="c4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="c5" value="&lt;font style=&quot;font-size:11px&quot;&gt;pulled by &lt;b&gt;digest&lt;/b&gt;, not by tag&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="430" y="582" width="410" height="60" as="geometry"/></mxCell>
<mxCell id="ei4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeWidth=2;fontSize=12;labelBackgroundColor=#ffffff;strokeColor=#6c8ebf;" edge="1" parent="1" source="i5" target="c5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="stop" value="&lt;b&gt;Any mismatch → the build stops&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;also: a launcher option changed, a jar missing, the old Wire jar gone&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="560" y="740" width="470" height="70" as="geometry"/></mxCell>
<mxCell id="estop" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeWidth=2;fontSize=12;labelBackgroundColor=#ffffff;strokeColor=#b85450;exitX=0.75;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="chk" target="stop"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="bld" value="&lt;b&gt;Build&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;verticalAlign=top;spacingTop=8;fontSize=14;arcSize=4;" vertex="1" parent="1"><mxGeometry x="960" y="120" width="330" height="330" as="geometry"/></mxCell>
<mxCell id="b1" value="&lt;font style=&quot;font-size:11px&quot;&gt;compile our launcher and TLS gateway&lt;br&gt;(MessageLogLauncher, TlsGateway)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="985" y="165" width="280" height="55" as="geometry"/></mxCell>
<mxCell id="b2" value="&lt;font style=&quot;font-size:11px&quot;&gt;jlink: a Java runtime with only&lt;br&gt;the modules signal-cli uses&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="985" y="235" width="280" height="55" as="geometry"/></mxCell>
<mxCell id="b3" value="&lt;font style=&quot;font-size:11px&quot;&gt;write java.args, so it starts&lt;br&gt;without a shell&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="985" y="305" width="280" height="55" as="geometry"/></mxCell>
<mxCell id="b4" value="&lt;font style=&quot;font-size:11px&quot;&gt;copy into distroless:&lt;br&gt;no shell, no package manager&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="985" y="375" width="280" height="55" as="geometry"/></mxCell>
<mxCell id="eb1b2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeWidth=2;fontSize=12;labelBackgroundColor=#ffffff;strokeColor=#6c8ebf;" edge="1" parent="1" source="b1" target="b2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="eb2b3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeWidth=2;fontSize=12;labelBackgroundColor=#ffffff;strokeColor=#6c8ebf;" edge="1" parent="1" source="b2" target="b3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="eb3b4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeWidth=2;fontSize=12;labelBackgroundColor=#ffffff;strokeColor=#6c8ebf;" edge="1" parent="1" source="b3" target="b4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="echk" value="all pass" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeWidth=2;fontSize=12;labelBackgroundColor=#ffffff;strokeColor=#82b366;strokeWidth=3;" edge="1" parent="1" source="chk" target="bld"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="scan" value="&lt;b&gt;Trivy scan&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;CRITICAL / HIGH must be 0&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="960" y="490" width="330" height="75" as="geometry"/></mxCell>
<mxCell id="escan" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeWidth=2;fontSize=12;labelBackgroundColor=#ffffff;strokeColor=#6c8ebf;" edge="1" parent="1" source="bld" target="scan"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="tag" value="&lt;b&gt;Tag signal-cli:VERSION&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;or VERSION-r2, -r3 … for a rebuild; the old tag stays&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="960" y="610" width="330" height="75" as="geometry"/></mxCell>
<mxCell id="etag" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeWidth=2;fontSize=12;labelBackgroundColor=#ffffff;strokeColor=#6c8ebf;" edge="1" parent="1" source="scan" target="tag"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="test" value="&lt;b&gt;Test&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;run it, send a group message,&lt;br&gt;check it arrives end to end&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="1380" y="120" width="280" height="90" as="geometry"/></mxCell>
<mxCell id="bak" value="&lt;b&gt;Back up the account&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;signal-cli stopped; a new version&lt;br&gt;may upgrade its database&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="1380" y="260" width="280" height="90" as="geometry"/></mxCell>
<mxCell id="dep" value="&lt;b&gt;Deploy&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;docker save / load,&lt;br&gt;change image: in the compose file&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="1380" y="400" width="280" height="90" as="geometry"/></mxCell>
<mxCell id="rb" value="&lt;b&gt;Rollback&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;old tag back in image:,&lt;br&gt;restore the backup if needed&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;dashed=1;" vertex="1" parent="1"><mxGeometry x="1380" y="540" width="280" height="90" as="geometry"/></mxCell>
<mxCell id="etest" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeWidth=2;fontSize=12;labelBackgroundColor=#ffffff;strokeColor=#82b366;" edge="1" parent="1" source="tag" target="test"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1335" y="647"/><mxPoint x="1335" y="165"/></Array></mxGeometry></mxCell>
<mxCell id="ebak" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeWidth=2;fontSize=12;labelBackgroundColor=#ffffff;strokeColor=#82b366;" edge="1" parent="1" source="test" target="bak"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="edep" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeWidth=2;fontSize=12;labelBackgroundColor=#ffffff;strokeColor=#82b366;" edge="1" parent="1" source="bak" target="dep"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="erb" value="&lt;font style=&quot;font-size:11px&quot;&gt;if it fails&lt;/font&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeWidth=2;fontSize=12;labelBackgroundColor=#ffffff;strokeColor=#d79b00;dashed=1;" edge="1" parent="1" source="dep" target="rb"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="cu" value="&lt;b&gt;check-update&lt;/b&gt; &lt;font style=&quot;font-size:11px&quot;&gt;(about monthly)&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;compares with the latest signal-cli and Wire,&lt;br&gt;new base-image digests and a fresh Trivy scan.&lt;br&gt;--prepare --apply --build downloads, re-runs&lt;br&gt;the checks, writes the new pins and builds.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="40" y="740" width="300" height="140" as="geometry"/></mxCell>
<mxCell id="ecu" value="&lt;font style=&quot;font-size:11px&quot;&gt;new release or&lt;br&gt;new digest&lt;/font&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeWidth=2;fontSize=12;labelBackgroundColor=#ffffff;strokeColor=#9673a6;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.2;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="cu" target="chk"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="190" y="715"/><mxPoint x="494" y="715"/></Array></mxGeometry></mxCell>
<mxCell id="why" value="&lt;font style=&quot;font-size:11px&quot;&gt;&lt;b&gt;Why monthly:&lt;/b&gt; Signal stops serving clients that fall too far behind, and new CVEs are published against packages that did not change.&lt;br&gt;&lt;b&gt;If the signing key changes:&lt;/b&gt; don't trust the key the new release points to; confirm it through the project first.&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="900" width="1300" height="90" as="geometry"/></mxCell>
</root></mxGraphModel></diagram></mxfile>
