<mxfile host="drawio" agent="signal-relay"><diagram id="d" name="signal-cli layers"><mxGraphModel grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="760" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/>
<mxCell id="title" value="&lt;b&gt;What signal-cli is made of&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot; color=&quot;#555555&quot;&gt;Four layers, top to bottom. signal-cli itself implements no encryption.&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=22;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1200" height="60" as="geometry"/></mxCell>
<mxCell id="l1" value="&lt;font style=&quot;font-size:15px&quot;&gt;&lt;b&gt;signal-cli&lt;/b&gt;&lt;/font&gt;&lt;br&gt;commands, daemon, JSON output, the account database" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=20;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="880" height="115" as="geometry"/></mxCell>
<mxCell id="l1f" value="&lt;font style=&quot;font-size:11px&quot;&gt;signal-cli-*.jar, libsignal-cli-*.jar&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffffff;strokeColor=#9aa5b1;dashed=1;" vertex="1" parent="1"><mxGeometry x="960" y="125" width="400" height="85" as="geometry"/></mxCell>
<mxCell id="l1e" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeWidth=2;fontSize=12;labelBackgroundColor=#ffffff;endArrow=none;dashed=1;strokeColor=#9aa5b1;strokeWidth=1;" edge="1" parent="1" source="l1" target="l1f"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="l2" value="&lt;font style=&quot;font-size:15px&quot;&gt;&lt;b&gt;signal-service-java&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Signal's server API: WebSocket, messages, groups, profiles, attachments&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Signal-Android's library, as maintained for signal-cli&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=20;" vertex="1" parent="1"><mxGeometry x="40" y="255" width="880" height="115" as="geometry"/></mxCell>
<mxCell id="l2f" value="&lt;font style=&quot;font-size:11px&quot;&gt;signal-service-java, signal-network,&lt;br&gt;core-network, models … (2.15.3_unofficial)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffffff;strokeColor=#9aa5b1;dashed=1;" vertex="1" parent="1"><mxGeometry x="960" y="270" width="400" height="85" as="geometry"/></mxCell>
<mxCell id="l2e" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeWidth=2;fontSize=12;labelBackgroundColor=#ffffff;endArrow=none;dashed=1;strokeColor=#9aa5b1;strokeWidth=1;" edge="1" parent="1" source="l2" target="l2f"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="s1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeWidth=2;fontSize=12;labelBackgroundColor=#ffffff;strokeColor=#6c8ebf;" edge="1" parent="1" source="l1" target="l2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="l3" value="&lt;font style=&quot;font-size:15px&quot;&gt;&lt;b&gt;libsignal&lt;/b&gt;&lt;/font&gt;&lt;br&gt;all the cryptography: Signal Protocol, sealed sender, group credentials&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Signal's own code (Rust), the same library the phone apps use&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=20;" vertex="1" parent="1"><mxGeometry x="40" y="400" width="880" height="115" as="geometry"/></mxCell>
<mxCell id="l3f" value="&lt;font style=&quot;font-size:11px&quot;&gt;libsignal-client-0.103.0.jar&lt;br&gt;(libsignal_jni_amd64.so inside)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffffff;strokeColor=#9aa5b1;dashed=1;" vertex="1" parent="1"><mxGeometry x="960" y="415" width="400" height="85" as="geometry"/></mxCell>
<mxCell id="l3e" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeWidth=2;fontSize=12;labelBackgroundColor=#ffffff;endArrow=none;dashed=1;strokeColor=#9aa5b1;strokeWidth=1;" edge="1" parent="1" source="l3" target="l3f"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="s2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeWidth=2;fontSize=12;labelBackgroundColor=#ffffff;strokeColor=#6c8ebf;" edge="1" parent="1" source="l2" target="l3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="l4" value="&lt;font style=&quot;font-size:15px&quot;&gt;&lt;b&gt;Java 25 runtime + SQLite + supporting libraries&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Jackson, OkHttp, Kotlin, Micronaut, Bouncy Castle …&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Wire runtime swapped to 6.3.0 for CVE-2026-45799&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#f5f7fa;strokeColor=#9aa5b1;align=left;spacingLeft=20;" vertex="1" parent="1"><mxGeometry x="40" y="545" width="880" height="115" as="geometry"/></mxCell>
<mxCell id="l4f" value="&lt;font style=&quot;font-size:11px&quot;&gt;jlinked Debian JRE&lt;br&gt;(only the modules signal-cli uses)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffffff;strokeColor=#9aa5b1;dashed=1;" vertex="1" parent="1"><mxGeometry x="960" y="560" width="400" height="85" as="geometry"/></mxCell>
<mxCell id="l4e" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeWidth=2;fontSize=12;labelBackgroundColor=#ffffff;endArrow=none;dashed=1;strokeColor=#9aa5b1;strokeWidth=1;" edge="1" parent="1" source="l4" target="l4f"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="s3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeWidth=2;fontSize=12;labelBackgroundColor=#ffffff;strokeColor=#6c8ebf;" edge="1" parent="1" source="l3" target="l4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="t1" value="&lt;b&gt;Files in the image&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=12;" vertex="1" parent="1"><mxGeometry x="960" y="80" width="400" height="30" as="geometry"/></mxCell>
<mxCell id="n1" value="• &lt;b&gt;signal-cli implements no encryption itself.&lt;/b&gt; Everything cryptographic is in libsignal, and the build checks it is byte-identical to Signal's release.&lt;br&gt;• That is why signal-cli must be Java: Signal publishes libsignal for Java, Swift and TypeScript, not Python." style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="690" width="1320" height="80" as="geometry"/></mxCell>
</root></mxGraphModel></diagram></mxfile>
