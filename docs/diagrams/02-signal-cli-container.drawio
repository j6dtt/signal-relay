<mxfile host="drawio" agent="signal-relay"><diagram id="d" name="Inside the signal-cli container"><mxGraphModel grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="1000" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/>
<mxCell id="title" value="&lt;b&gt;Inside the signal-cli container&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot; color=&quot;#555555&quot;&gt;In-house image: official signal-cli and libsignal, plus our launcher and TLS gateway&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=22;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1200" height="60" as="geometry"/></mxCell>
<mxCell id="cloud" value="&lt;b&gt;Signal servers&lt;/b&gt;&lt;br&gt;chat.signal.org" style="ellipse;shape=cloud;whiteSpace=wrap;html=1;fontSize=14;fillColor=#eef3f8;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="570" y="60" width="280" height="130" as="geometry"/></mxCell>
<mxCell id="ct" value="&lt;b&gt;container signal-cli&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;read-only system · runs as the relay user · no shell · all extra privileges dropped · memory and process limits&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;verticalAlign=top;align=left;spacingLeft=16;spacingTop=6;fontSize=14;arcSize=3;" vertex="1" parent="1"><mxGeometry x="300" y="300" width="800" height="480" as="geometry"/></mxCell>
<mxCell id="java" value="&lt;b&gt;java @java.args&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;starts the launcher&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="330" y="365" width="170" height="50" as="geometry"/></mxCell>
<mxCell id="launch" value="&lt;b&gt;MessageLogLauncher&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;our code: runs signal-cli in&lt;br&gt;the same Java process,&lt;br&gt;redacts its message log&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="330" y="440" width="170" height="90" as="geometry"/></mxCell>
<mxCell id="main" value="&lt;b&gt;signal-cli (unchanged)&lt;/b&gt;&lt;br&gt;&lt;br&gt;② decrypts each message&lt;br&gt;with libsignal, using the keys in /data&lt;br&gt;③ turns it into a JSON event,&lt;br&gt;kept in memory (up to 1,000)&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;HTTP on 127.0.0.1:8080: inside only&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="560" y="390" width="300" height="190" as="geometry"/></mxCell>
<mxCell id="gw" value="&lt;b&gt;TLS gateway :8443&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;our code&lt;/font&gt;&lt;br&gt;④ mutual TLS 1.3&lt;br&gt;accepts only the subscriber's certificate&lt;br&gt;allows: event stream · health check · listContacts" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffffff;strokeColor=#6c8ebf;strokeColor=#2f5597;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="560" y="625" width="300" height="130" as="geometry"/></mxCell>
<mxCell id="blocked" value="&lt;b&gt;send ✗ refused&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;and every other call&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="905" y="662" width="170" height="55" as="geometry"/></mxCell>
<mxCell id="log" value="&lt;b&gt;container log&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;one redacted line per event&lt;br&gt;(MESSAGE_LOG=redacted)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffffff;strokeColor=#9aa5b1;" vertex="1" parent="1"><mxGeometry x="330" y="650" width="170" height="90" as="geometry"/></mxCell>
<mxCell id="tmp" value="&lt;b&gt;/tmp&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;in memory: libsignal&lt;br&gt;unpacks its library here&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffffff;strokeColor=#9aa5b1;dashed=1;" vertex="1" parent="1"><mxGeometry x="905" y="400" width="170" height="70" as="geometry"/></mxCell>
<mxCell id="e_java" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeWidth=2;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="java" target="launch"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="e_lmain" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeWidth=2;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="launch" target="main"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="e_llog" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeWidth=2;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="launch" target="log"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="e_gwmain" value="&lt;font style=&quot;font-size:11px&quot;&gt;127.0.0.1:8080&lt;/font&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeWidth=2;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="gw" target="main"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="e_gwblk" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeWidth=2;fontSize=12;labelBackgroundColor=#ffffff;strokeColor=#b85450;" edge="1" parent="1" source="gw" target="blocked"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="e_out" value="① connects out · HTTPS / WebSocket 443&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;messages come back down the same connection&lt;/font&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeWidth=2;fontSize=12;labelBackgroundColor=#ffffff;strokeColor=#6c8ebf;startArrow=block;" edge="1" parent="1" source="main" target="cloud"><mxGeometry x="0.45" relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="data" value="&lt;b&gt;low/signal-data → /data&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;the account's keys and sessions&lt;br&gt;read-write, mode 700&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;size=10;fontSize=12;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="320" y="830" width="220" height="90" as="geometry"/></mxCell>
<mxCell id="certs" value="&lt;b&gt;low/certs/signal → /certs&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;server certificate and CA&lt;br&gt;read-only&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;size=10;fontSize=12;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="900" y="830" width="220" height="90" as="geometry"/></mxCell>
<mxCell id="e_data" value="&lt;font style=&quot;font-size:11px&quot;&gt;mounted&lt;/font&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeWidth=2;fontSize=12;labelBackgroundColor=#ffffff;dashed=1;strokeColor=#d6b656;endArrow=none;labelBackgroundColor=#ffffff;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.1625;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="data" target="ct"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="e_certs" value="&lt;font style=&quot;font-size:11px&quot;&gt;mounted&lt;/font&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeWidth=2;fontSize=12;labelBackgroundColor=#ffffff;dashed=1;strokeColor=#d6b656;endArrow=none;labelBackgroundColor=#ffffff;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.8875;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="certs" target="ct"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="sub" value="&lt;b&gt;subscriber&lt;/b&gt;&lt;br&gt;&lt;br&gt;⑤ GET /api/v1/events&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;a stream that stays open (SSE)&lt;br&gt;+ listContacts for display names&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="580" y="850" width="260" height="110" as="geometry"/></mxCell>
<mxCell id="e_sub" value="&lt;b&gt;mutual TLS 1.3&lt;/b&gt; · &lt;font style=&quot;font-size:11px&quot;&gt;client certificate&lt;/font&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeWidth=2;fontSize=12;labelBackgroundColor=#ffffff;strokeWidth=4;strokeColor=#2f5597;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="sub" target="gw"><mxGeometry relative="1" as="geometry"><mxPoint x="110" y="0" as="offset"/></mxGeometry></mxCell>
<mxCell id="note" value="&lt;b&gt;Ports&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;8443 is published (for example as 443) only when the subscriber runs on another host. On one host, nothing is published and the subscriber uses the container name.&lt;br&gt;&lt;br&gt;Nothing connects in from Signal: the only outside connection is ①, outbound.&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1140" y="300" width="330" height="220" as="geometry"/></mxCell>
</root></mxGraphModel></diagram></mxfile>
