<mxfile host="drawio" agent="signal-relay">
  <diagram id="e2e" name="End-to-end relay">
    <mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="960" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- title -->
        <mxCell id="title" value="&lt;b&gt;Signal Chat Relay: end to end&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot; color=&quot;#555555&quot;&gt;Signal group chat, one way across a data diode&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=22;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="900" height="60" as="geometry" />
        </mxCell>

        <!-- zones -->
        <mxCell id="zoneL" value="LEFT of the diode&lt;br&gt;&lt;font style=&quot;font-size:12px;font-weight:normal&quot;&gt;compose project signal-left · folder left/&lt;/font&gt;" style="rounded=1;arcSize=3;html=1;whiteSpace=wrap;fillColor=#f5f7fa;strokeColor=#9aa5b1;dashed=1;verticalAlign=bottom;align=left;spacingLeft=14;spacingBottom=8;fontStyle=1;fontSize=15;fontColor=#33414e;" vertex="1" parent="1">
          <mxGeometry x="40" y="250" width="710" height="590" as="geometry" />
        </mxCell>
        <mxCell id="zoneR" value="RIGHT of the diode&lt;br&gt;&lt;font style=&quot;font-size:12px;font-weight:normal&quot;&gt;compose project signal-right · folder right/&lt;/font&gt;" style="rounded=1;arcSize=3;html=1;whiteSpace=wrap;fillColor=#f5f7fa;strokeColor=#9aa5b1;dashed=1;verticalAlign=bottom;align=left;spacingLeft=14;spacingBottom=8;fontStyle=1;fontSize=15;fontColor=#33414e;" vertex="1" parent="1">
          <mxGeometry x="930" y="250" width="684" height="590" as="geometry" />
        </mxCell>

        <!-- Signal side -->
        <mxCell id="cloud" value="&lt;b&gt;Signal servers&lt;/b&gt;&lt;br&gt;chat.signal.org" style="ellipse;shape=cloud;whiteSpace=wrap;html=1;fillColor=#eef3f8;strokeColor=#6c8ebf;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="80" y="90" width="260" height="130" as="geometry" />
        </mxCell>
        <mxCell id="phones" value="&lt;b&gt;Group members&lt;/b&gt;&lt;br&gt;phones, Signal Desktop" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="470" y="115" width="220" height="80" as="geometry" />
        </mxCell>
        <mxCell id="e_phones" value="end-to-end encrypted" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;startArrow=block;strokeWidth=2;strokeColor=#6c8ebf;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="phones" target="cloud">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- signal-cli container -->
        <mxCell id="sc" value="&lt;b&gt;signal-cli container&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;in-house image · official Signal software&lt;/font&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;verticalAlign=top;spacingTop=6;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="70" y="320" width="280" height="300" as="geometry" />
        </mxCell>
        <mxCell id="daemon" value="&lt;b&gt;signal-cli daemon&lt;/b&gt;&lt;br&gt;decrypts with libsignal&lt;br&gt;HTTP on 127.0.0.1:8080&lt;br&gt;&lt;i&gt;(inside the container only)&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="90" y="375" width="240" height="95" as="geometry" />
        </mxCell>
        <mxCell id="gw" value="&lt;b&gt;TLS gateway :8443&lt;/b&gt;&lt;br&gt;mutual TLS 1.3&lt;br&gt;read-only allowlist (no send)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2f5597;strokeWidth=2;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="90" y="515" width="240" height="85" as="geometry" />
        </mxCell>
        <mxCell id="e_dgw" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeWidth=2;strokeColor=#6c8ebf;" edge="1" parent="1" source="daemon" target="gw">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="keys" value="&lt;b&gt;left/signal-data&lt;/b&gt;&lt;br&gt;the account's keys" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;size=10;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="125" y="660" width="170" height="85" as="geometry" />
        </mxCell>
        <mxCell id="e_keys" value="mounted at /data" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=none;dashed=1;strokeColor=#d6b656;strokeWidth=2;fontSize=11;labelBackgroundColor=#f5f7fa;" edge="1" parent="1" source="keys" target="sc">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_cloud" value="messages&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;HTTPS 443 · signal-cli connects out,&lt;br&gt;nothing connects in&lt;/font&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeWidth=2;strokeColor=#6c8ebf;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="cloud" target="sc">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- subscribers (stacked: one per group) -->
        <mxCell id="sub2" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="472" y="462" width="250" height="150" as="geometry" />
        </mxCell>
        <mxCell id="sub" value="&lt;b&gt;subscriber&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;one per group, or several groups in one&lt;/font&gt;&lt;br&gt;&lt;br&gt;keeps only the chosen group(s)&lt;br&gt;adds display names&lt;br&gt;splits into ≤ 1472-byte CEF lines" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="460" y="475" width="250" height="150" as="geometry" />
        </mxCell>
        <mxCell id="e_tls" value="&lt;b&gt;mutual TLS 1.3&lt;/b&gt;&lt;br&gt;event stream (SSE)&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;same host or across networks&lt;/font&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeWidth=4;strokeColor=#2f5597;fontSize=12;labelBackgroundColor=#f5f7fa;" edge="1" parent="1" source="gw" target="sub">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- diode -->
        <mxCell id="diode" value="&lt;b&gt;DATA DIODE&lt;/b&gt;&lt;br&gt;one way only" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;horizontal=0;fontSize=16;" vertex="1" parent="1">
          <mxGeometry x="790" y="250" width="100" height="590" as="geometry" />
        </mxCell>
        <mxCell id="e_udp1" value="CEF over UDP&lt;br&gt;port 6510" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeWidth=3;strokeColor=#b85450;dashed=1;fontSize=12;labelBackgroundColor=none;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5085;entryDx=0;entryDy=0;" edge="1" parent="1" source="sub" target="diode">
          <mxGeometry relative="1" as="geometry"><mxPoint x="0" y="-32" as="offset" /></mxGeometry>
        </mxCell>
        <mxCell id="e_udp2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeWidth=3;strokeColor=#b85450;dashed=1;exitX=1;exitY=0.5085;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="diode" target="recv">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- right side -->
        <mxCell id="recv" value="&lt;b&gt;receiver&lt;/b&gt;&lt;br&gt;&lt;br&gt;rebuilds each message from its parts&lt;br&gt;reports lost / duplicate packets&lt;br&gt;makes a simple record per message" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="960" y="475" width="260" height="150" as="geometry" />
        </mxCell>
        <mxCell id="ext" value="&lt;b&gt;External platform&lt;/b&gt;&lt;br&gt;Palantir (planned)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;dashed=1;strokeWidth=2;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="1310" y="320" width="270" height="90" as="geometry" />
        </mxCell>
        <mxCell id="e_ext" value="simple records&lt;br&gt;my_forward()" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeWidth=2;strokeColor=#d6b656;dashed=1;fontSize=12;labelBackgroundColor=#f5f7fa;" edge="1" parent="1" source="recv" target="ext">
          <mxGeometry relative="1" as="geometry">
            <Array as="points"><mxPoint x="1090" y="365" /></Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="play" value="&lt;b&gt;playback&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;local chat playback (POC), temporary&lt;/font&gt;&lt;br&gt;&lt;br&gt;chat and terminal views" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1310" y="475" width="270" height="150" as="geometry" />
        </mxCell>
        <mxCell id="e_play" value="HTTP :8091&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;internal&lt;/font&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeWidth=2;strokeColor=#9673a6;fontSize=12;labelBackgroundColor=#f5f7fa;" edge="1" parent="1" source="recv" target="play">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="browser" value="&lt;b&gt;Browser&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="1355" y="690" width="180" height="60" as="geometry" />
        </mxCell>
        <mxCell id="e_browser" value="HTTPS :8090" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeWidth=2;strokeColor=#9673a6;fontSize=12;labelBackgroundColor=#f5f7fa;" edge="1" parent="1" source="play" target="browser">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- legend -->
        <mxCell id="lg1" value="" style="endArrow=block;html=1;strokeWidth=4;strokeColor=#2f5597;" edge="1" parent="1">
          <mxGeometry width="50" height="50" relative="1" as="geometry">
            <mxPoint x="40" y="880" as="sourcePoint" /><mxPoint x="100" y="880" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="lt1" value="mutual TLS 1.3: both sides prove who they are" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="110" y="865" width="300" height="30" as="geometry" />
        </mxCell>
        <mxCell id="lg2" value="" style="endArrow=block;html=1;strokeWidth=3;strokeColor=#b85450;dashed=1;" edge="1" parent="1">
          <mxGeometry width="50" height="50" relative="1" as="geometry">
            <mxPoint x="440" y="880" as="sourcePoint" /><mxPoint x="500" y="880" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="lt2" value="CEF over UDP: the only thing that crosses the diode" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="510" y="865" width="330" height="30" as="geometry" />
        </mxCell>
        <mxCell id="lt3" value="&lt;b&gt;Nothing flows back&lt;/b&gt; from right to left." style="text;html=1;align=left;verticalAlign=middle;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="880" y="865" width="420" height="30" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
