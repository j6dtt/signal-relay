<mxCell id="s2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeWidth=2;fontSize=12;labelBackgroundColor=#ffffff;strokeWidth=2;strokeColor=#d79b00;dashed=1;dashPattern=2 3;jumpStyle=arc;jumpSize=10;exitX=1;exitY=0.85;exitDx=0;exitDy=0;entryX=0.75;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="a2" target="mon"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="717" y="359"/><mxPoint x="717" y="686"/><mxPoint x="328" y="686"/></Array></mxGeometry></mxCell>
