<mxfile host="drawio" agent="signal-relay"><diagram id="d" name="Relay monitoring design"><mxGraphModel grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2000" pageHeight="1150" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/>
<mxCell id="title" value="&lt;b&gt;Relay monitoring: proposed design (for review)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot; color=&quot;#555555&quot;&gt;Chat and monitoring cross the same diode on separate UDP ports. Nothing flows from right to left.&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=22;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1200" height="60" as="geometry"/></mxCell>
<mxCell id="lz" value="LEFT: signal-cli host (Docker Compose)" style="rounded=1;arcSize=3;html=1;whiteSpace=wrap;dashed=1;verticalAlign=bottom;align=left;spacingLeft=14;spacingBottom=8;fontStyle=1;fontSize=15;fontColor=#33414e;fillColor=#f5f7fa;strokeColor=#9aa5b1;" vertex="1" parent="1"><mxGeometry x="30" y="100" width="730" height="870" as="geometry"/></mxCell>
<mxCell id="i1" value="instance relay-1" style="rounded=1;arcSize=3;html=1;whiteSpace=wrap;dashed=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=13;fontColor=#33414e;fillColor=#ffffff;strokeColor=#9aa5b1;" vertex="1" parent="1"><mxGeometry x="50" y="130" width="690" height="300" as="geometry"/></mxCell>
<mxCell id="sa" value="&lt;b&gt;signal-cli&lt;/b&gt; (relay-1)&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;TLS gateway :8443 (mutual TLS)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="80" y="200" width="230" height="90" as="geometry"/></mxCell>
<mxCell id="a1" value="&lt;b&gt;subscriber&lt;/b&gt; ops&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;group filter, split → CEF&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="460" y="170" width="230" height="70" as="geometry"/></mxCell>
<mxCell id="a2" value="&lt;b&gt;subscriber&lt;/b&gt; logistics&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;group filter, split → CEF&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="460" y="300" width="230" height="70" as="geometry"/></mxCell>
<mxCell id="i2" value="instance relay-2 (a second account)" style="rounded=1;arcSize=3;html=1;whiteSpace=wrap;dashed=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=13;fontColor=#33414e;fillColor=#ffffff;strokeColor=#9aa5b1;" vertex="1" parent="1"><mxGeometry x="50" y="450" width="690" height="200" as="geometry"/></mxCell>
<mxCell id="sb" value="&lt;b&gt;signal-cli&lt;/b&gt; (relay-2)&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;TLS gateway :8443 (mutual TLS)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="80" y="510" width="230" height="90" as="geometry"/></mxCell>
<mxCell id="b1" value="&lt;b&gt;subscriber&lt;/b&gt; intel&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;group filter, split → CEF&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="460" y="520" width="230" height="70" as="geometry"/></mxCell>
<mxCell id="mon" value="&lt;b&gt;signal-monitor&lt;/b&gt; &lt;font style=&quot;font-size:11px&quot;&gt;(new · one per host)&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;• checks each signal-cli: GET /api/v1/check&lt;br&gt;• hears each subscriber's status (every 10 s)&lt;br&gt;• disk on logs/, certificate expiry, clock&lt;br&gt;• sends a heartbeat every 30 s,&lt;br&gt;&amp;nbsp;&amp;nbsp;plus an event when anything changes&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="80" y="720" width="330" height="200" as="geometry"/></mxCell>
<mxCell id="splitnote" value="&lt;font style=&quot;font-size:11px&quot;&gt;&lt;b&gt;Each part has a stable identity:&lt;/b&gt;&lt;br&gt;instance (RELAY_ID), container name, host (MONITOR_HOST).&lt;br&gt;&lt;br&gt;&lt;b&gt;Split hosts:&lt;/b&gt; a subscriber on another host sends its status to that host's own signal-monitor (MONITOR_ADDR).&lt;br&gt;&lt;br&gt;&lt;b&gt;No message content&lt;/b&gt; ever goes into monitoring.&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=12;" vertex="1" parent="1"><mxGeometry x="440" y="740" width="290" height="170" as="geometry"/></mxCell>
<mxCell id="t1" value="event stream" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeWidth=2;fontSize=12;labelBackgroundColor=#ffffff;strokeWidth=4;strokeColor=#2f5597;exitX=1;exitY=0.25;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="sa" target="a1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
