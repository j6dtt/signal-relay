<mxCell id="u2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeWidth=2;fontSize=12;labelBackgroundColor=#ffffff;strokeWidth=3;strokeColor=#b85450;dashed=1;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.507;entryDx=0;entryDy=0;" edge="1" parent="1" source="b1" target="diode"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="um" value="&lt;font style=&quot;font-size:11px&quot;&gt;monitoring · UDP 6511&lt;/font&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeWidth=2;fontSize=12;labelBackgroundColor=#ffffff;strokeWidth=3;strokeColor=#d79b00;dashed=1;dashPattern=8 4;exitX=1;exitY=0.85;exitDx=0;exitDy=0;entryX=0;entryY=0.908;entryDx=0;entryDy=0;" edge="1" parent="1" source="mon" target="diode"><mxGeometry x="0.75" relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="rz" value="RIGHT: Docker containers today (k8s later)" style="rounded=1;arcSize=3;html=1;whiteSpace=wrap;dashed=1;verticalAlign=bottom;align=left;spacingLeft=14;spacingBottom=8;fontStyle=1;fontSize=15;fontColor=#33414e;fillColor=#f5f7fa;strokeColor=#9aa5b1;" vertex="1" parent="1"><mxGeometry x="910" y="100" width="1060" height="870" as="geometry"/></mxCell>
<mxCell id="rcv" value="&lt;b&gt;receiver&lt;/b&gt; &lt;font style=&quot;font-size:11px&quot;&gt;(chat · unchanged)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#e1d5e7;strokeColor=#9673a6;verticalAlign=top;spacingTop=8;fontSize=14;arcSize=3;" vertex="1" parent="1"><mxGeometry x="950" y="140" width="320" height="450" as="geometry"/></mxCell>
<mxCell id="rc" value="&lt;b&gt;UDP 6510: chat&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;reassemble → Signal event&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="975" y="190" width="270" height="80" as="geometry"/></mxCell>
<mxCell id="rr" value="&lt;b&gt;Chat.record() → my_forward&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;simple record · prod: hand-off&lt;br&gt;toward Gotham (out of scope)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="975" y="310" width="270" height="90" as="geometry"/></mxCell>
<mxCell id="rcr" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeWidth=2;fontSize=12;labelBackgroundColor=#ffffff;strokeColor=#9673a6;" edge="1" parent="1" source="rc" target="rr"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="rnote" value="&lt;font style=&quot;font-size:11px&quot;&gt;Never touches the database: passes everything to playback over HTTP, as today.&lt;br&gt;&lt;br&gt;Its counters (/stats) double as its heartbeat: if they stop, playback shows the receiver DOWN.&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;fontColor=#4a4a4a;" vertex="1" parent="1"><mxGeometry x="975" y="420" width="270" height="150" as="geometry"/></mxCell>
<mxCell id="mrcv" value="&lt;b&gt;monitor-receiver&lt;/b&gt; &lt;font style=&quot;font-size:11px&quot;&gt;(new · own container)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#e1d5e7;strokeColor=#9673a6;verticalAlign=top;spacingTop=8;fontSize=14;arcSize=3;" vertex="1" parent="1"><mxGeometry x="950" y="640" width="320" height="290" as="geometry"/></mxCell>
<mxCell id="rm" value="&lt;b&gt;UDP 6511: monitoring&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;one datagram per message:&lt;br&gt;check the header → pass on&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="975" y="690" width="270" height="80" as="geometry"/></mxCell>
<mxCell id="mnote" value="&lt;font style=&quot;font-size:11px&quot;&gt;Sends its own heartbeat to playback every 30 s, so a dead monitor-receiver isn't mistaken for the whole left side going silent.&lt;br&gt;&lt;br&gt;Restarting or changing it never touches chat.&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;fontColor=#4a4a4a;" vertex="1" parent="1"><mxGeometry x="975" y="785" width="270" height="140" as="geometry"/></mxCell>
<mxCell id="dc" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeWidth=2;fontSize=12;labelBackgroundColor=#ffffff;strokeWidth=3;strokeColor=#b85450;dashed=1;exitX=1;exitY=0.149;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="diode" target="rc"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="dm" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeWidth=2;fontSize=12;labelBackgroundColor=#ffffff;strokeWidth=3;strokeColor=#d79b00;dashed=1;dashPattern=8 4;exitX=1;exitY=0.724;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="diode" target="rm"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="pb" value="&lt;b&gt;playback&lt;/b&gt; &lt;font style=&quot;font-size:11px&quot;&gt;(one container · owns the database)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#e1d5e7;strokeColor=#9673a6;verticalAlign=top;spacingTop=8;fontSize=14;arcSize=3;" vertex="1" parent="1"><mxGeometry x="1350" y="140" width="360" height="560" as="geometry"/></mxCell>
<mxCell id="p1" value="&lt;b&gt;Local login&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;users in the database, scrypt passwords,&lt;br&gt;12-hour session cookie&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="1375" y="190" width="310" height="80" as="geometry"/></mxCell>
<mxCell id="p2" value="&lt;b&gt;Chat tabs&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;All (default) + one per group&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="1375" y="290" width="310" height="80" as="geometry"/></mxCell>
<mxCell id="p3" value="&lt;b&gt;Monitor tab&lt;/b&gt; &lt;font style=&quot;font-size:11px&quot;&gt;(new)&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;tiles per instance: UP / STALE / DOWN,&lt;br&gt;event log, diode loss and delay&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="1375" y="390" width="310" height="80" as="geometry"/></mxCell>
<mxCell id="p4" value="&lt;b&gt;Health checks&lt;/b&gt; &lt;font style=&quot;font-size:11px&quot;&gt;(new)&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;no heartbeat 90 s → STALE, 3 min → DOWN&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="1375" y="490" width="310" height="80" as="geometry"/></mxCell>
<mxCell id="p5" value="&lt;b&gt;Cleanup&lt;/b&gt; &lt;font style=&quot;font-size:11px&quot;&gt;(new)&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;hourly: delete anything older than 30 days&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="1375" y="590" width="310" height="80" as="geometry"/></mxCell>
<mxCell id="hc" value="&lt;font style=&quot;font-size:11px&quot;&gt;HTTP :8091&lt;br&gt;/event /notice /stats&lt;/font&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeWidth=2;fontSize=12;labelBackgroundColor=#ffffff;strokeWidth=2;strokeColor=#9673a6;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.165;entryDx=0;entryDy=0;" edge="1" parent="1" source="rc" target="pb"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="hm" value="&lt;font style=&quot;font-size:11px&quot;&gt;HTTP :8091&lt;br&gt;/monitor (new)&lt;/font&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeWidth=2;fontSize=12;labelBackgroundColor=#ffffff;strokeWidth=2;strokeColor=#9673a6;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.85;entryDx=0;entryDy=0;" edge="1" parent="1" source="rm" target="pb"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1305" y="730"/><mxPoint x="1305" y="616"/></Array></mxGeometry></mxCell>
<mxCell id="db" value="&lt;b&gt;right/data/relay.db&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;SQLite · chat history, monitoring&lt;br&gt;events, users, sessions&lt;br&gt;kept 30 days, survives restarts&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;size=10;fontSize=12;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="1420" y="780" width="220" height="140" as="geometry"/></mxCell>
<mxCell id="pdb" value="&lt;font style=&quot;font-size:11px&quot;&gt;read / write&lt;/font&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeWidth=2;fontSize=12;labelBackgroundColor=#ffffff;strokeWidth=2;strokeColor=#9673a6;startArrow=block;startFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="pb" target="db"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="br" value="&lt;b&gt;Browsers&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;HTTPS :8090&lt;br&gt;log in&lt;br&gt;&lt;br&gt;notifications while&lt;br&gt;a page is open&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="1770" y="300" width="180" height="210" as="geometry"/></mxCell>
<mxCell id="pbr" value="&lt;font style=&quot;font-size:11px&quot;&gt;live updates&lt;/font&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeWidth=2;fontSize=12;labelBackgroundColor=#ffffff;strokeWidth=2;strokeColor=#9673a6;exitX=1;exitY=0.4;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="pb" target="br"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="lgt" value="&lt;b&gt;Lines&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="1005" width="90" height="30" as="geometry"/></mxCell>
