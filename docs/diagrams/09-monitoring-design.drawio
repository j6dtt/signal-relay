<mxfile host="drawio" agent="signal-relay"><diagram id="d" name="Relay monitoring design"><mxGraphModel grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2000" pageHeight="1150" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/>
<mxCell id="title" value="&lt;b&gt;Relay monitoring: design as built (19 Oct 2026)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot; color=&quot;#555555&quot;&gt;Chat and monitoring cross the same diode, each on its own route (the diode routes by CEF header). Nothing flows from the high side to the low side. Every app is watched from the inside: problems by code, stuck workers, every hop counted.&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=22;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1200" height="60" as="geometry"/></mxCell>
<mxCell id="lz" value="LOW SIDE: signal-cli host (Docker Compose)" style="rounded=1;arcSize=3;html=1;whiteSpace=wrap;dashed=1;verticalAlign=bottom;align=left;spacingLeft=14;spacingBottom=8;fontStyle=1;fontSize=15;fontColor=#33414e;fillColor=#f5f7fa;strokeColor=#9aa5b1;" vertex="1" parent="1"><mxGeometry x="30" y="100" width="730" height="870" as="geometry"/></mxCell>
<mxCell id="i1" value="signal-cli" style="rounded=1;arcSize=3;html=1;whiteSpace=wrap;dashed=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=13;fontColor=#33414e;fillColor=#ffffff;strokeColor=#9aa5b1;" vertex="1" parent="1"><mxGeometry x="50" y="130" width="690" height="300" as="geometry"/></mxCell>
<mxCell id="sa" value="&lt;b&gt;signal-cli&lt;/b&gt; &lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;TLS gateway :8443 (mutual TLS, per-client rules)&lt;br&gt;health check (image r2): its link to Signal,&lt;br&gt;receive loop, Java memory, problems by code&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="80" y="200" width="230" height="110" as="geometry"/></mxCell>
<mxCell id="a1" value="&lt;b&gt;subscriber&lt;/b&gt; ops&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;routes.conf: a room per group, split → CEF&lt;br&gt;counts gaps in signal-cli&#x27;s event numbers,&lt;br&gt;numbers what it sends, problems by code&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="460" y="170" width="230" height="86" as="geometry"/></mxCell>
<mxCell id="a2" value="&lt;b&gt;subscriber&lt;/b&gt; logistics&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;routes.conf: a room per group, split → CEF&lt;br&gt;counts gaps in signal-cli&#x27;s event numbers,&lt;br&gt;numbers what it sends, problems by code&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="460" y="300" width="230" height="86" as="geometry"/></mxCell>
<mxCell id="i2" value="signal-cli-2 (a second account)" style="rounded=1;arcSize=3;html=1;whiteSpace=wrap;dashed=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=13;fontColor=#33414e;fillColor=#ffffff;strokeColor=#9aa5b1;" vertex="1" parent="1"><mxGeometry x="50" y="450" width="690" height="200" as="geometry"/></mxCell>
<mxCell id="sb" value="&lt;b&gt;signal-cli-2&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;TLS gateway :8443 (mutual TLS, per-client rules)&lt;br&gt;health check (image r2): its link to Signal,&lt;br&gt;receive loop, Java memory, problems by code&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="80" y="510" width="230" height="110" as="geometry"/></mxCell>
<mxCell id="b1" value="&lt;b&gt;subscriber&lt;/b&gt; intel&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;routes.conf: a room per group, split → CEF&lt;br&gt;counts gaps in signal-cli&#x27;s event numbers,&lt;br&gt;numbers what it sends, problems by code&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="460" y="520" width="230" height="86" as="geometry"/></mxCell>
<mxCell id="mon" value="&lt;b&gt;signal-monitor&lt;/b&gt; &lt;font style=&quot;font-size:11px&quot;&gt;(one per host)&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;• checks each signal-cli: GET /api/v1/check&lt;br&gt;&amp;nbsp;&amp;nbsp;(+ its link to Signal&#x27;s servers, r2)&lt;br&gt;• hears each subscriber&#x27;s status (every 10 s)&lt;br&gt;&amp;nbsp;&amp;nbsp;and turns its codes and counts into a state&lt;br&gt;• container facts: only news crosses&lt;br&gt;• disk, certificate expiry; heartbeat every 30 s&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="80" y="720" width="330" height="200" as="geometry"/></mxCell>
<mxCell id="splitnote" value="&lt;font style=&quot;font-size:11px&quot;&gt;&lt;b&gt;Each part has a stable identity:&lt;/b&gt;&lt;br&gt;container name + host name, no settings.&lt;br&gt;&lt;b&gt;Split hosts:&lt;/b&gt; status to that host&#x27;s signal-monitor (MONITOR_ADDR, MONITOR_NAME, RELAY_ID).&lt;br&gt;&lt;b&gt;No message content and no log text&lt;/b&gt; ever go into monitoring: only codes and counts.&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=12;" vertex="1" parent="1"><mxGeometry x="440" y="792" width="290" height="90" as="geometry"/></mxCell>
<mxCell id="t1" value="event stream" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeWidth=2;fontSize=12;labelBackgroundColor=#ffffff;strokeWidth=4;strokeColor=#2f5597;exitX=1;exitY=0.25;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="sa" target="a1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="t2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeWidth=2;fontSize=12;labelBackgroundColor=#ffffff;strokeWidth=4;strokeColor=#2f5597;exitX=1;exitY=0.75;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="sa" target="a2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="t3" value="event stream" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeWidth=2;fontSize=12;labelBackgroundColor=#ffffff;strokeWidth=4;strokeColor=#2f5597;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="sb" target="b1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="c1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeWidth=2;fontSize=12;labelBackgroundColor=#ffffff;strokeWidth=2;strokeColor=#6c8ebf;dashed=1;exitX=0;exitY=0.2;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="mon" target="sa"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="62" y="760"/><mxPoint x="62" y="245"/></Array></mxGeometry></mxCell>
<mxCell id="c2" value="&lt;font style=&quot;font-size:11px&quot;&gt;health check&lt;br&gt;(own certificate)&lt;/font&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeWidth=2;fontSize=12;labelBackgroundColor=#ffffff;strokeWidth=2;strokeColor=#6c8ebf;dashed=1;exitX=0.2;exitY=0;exitDx=0;exitDy=0;entryX=0.2;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="mon" target="sb"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="s1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeWidth=2;fontSize=12;labelBackgroundColor=#ffffff;strokeWidth=2;strokeColor=#d79b00;dashed=1;dashPattern=2 3;jumpStyle=arc;jumpSize=10;exitX=1;exitY=0.85;exitDx=0;exitDy=0;entryX=0.9;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="a1" target="mon"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="729" y="229"/><mxPoint x="729" y="700"/><mxPoint x="377" y="700"/></Array></mxGeometry></mxCell>
<mxCell id="s2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeWidth=2;fontSize=12;labelBackgroundColor=#ffffff;strokeWidth=2;strokeColor=#d79b00;dashed=1;dashPattern=2 3;jumpStyle=arc;jumpSize=10;exitX=1;exitY=0.85;exitDx=0;exitDy=0;entryX=0.75;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="a2" target="mon"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="717" y="359"/><mxPoint x="717" y="686"/><mxPoint x="328" y="686"/></Array></mxGeometry></mxCell>
<mxCell id="s3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeWidth=2;fontSize=12;labelBackgroundColor=#ffffff;strokeWidth=2;strokeColor=#d79b00;dashed=1;dashPattern=2 3;jumpStyle=arc;jumpSize=10;exitX=1;exitY=0.85;exitDx=0;exitDy=0;entryX=0.6;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="b1" target="mon"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="705" y="579"/><mxPoint x="705" y="672"/><mxPoint x="278" y="672"/></Array></mxGeometry></mxCell>
<mxCell id="stl" value="&lt;font style=&quot;font-size:11px&quot;&gt;&lt;b&gt;status&lt;/b&gt; every 10 s (local)&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=12;" vertex="1" parent="1"><mxGeometry x="470" y="704" width="230" height="24" as="geometry"/></mxCell>
<mxCell id="diode" value="&lt;b&gt;DATA&lt;br&gt;DIODE&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;one-way&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#f8cecc;strokeColor=#b85450;fontSize=13;" vertex="1" parent="1"><mxGeometry x="800" y="100" width="70" height="870" as="geometry"/></mxCell>
<mxCell id="u0" value="&lt;font style=&quot;font-size:11px&quot;&gt;chat · by room&lt;/font&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeWidth=2;fontSize=12;labelBackgroundColor=#ffffff;strokeWidth=3;strokeColor=#b85450;dashed=1;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.105;entryDx=0;entryDy=0;" edge="1" parent="1" source="a1" target="diode"><mxGeometry x="-0.35" relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="u1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeWidth=2;fontSize=12;labelBackgroundColor=#ffffff;strokeWidth=3;strokeColor=#b85450;dashed=1;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.254;entryDx=0;entryDy=0;" edge="1" parent="1" source="a2" target="diode"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="u2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeWidth=2;fontSize=12;labelBackgroundColor=#ffffff;strokeWidth=3;strokeColor=#b85450;dashed=1;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.507;entryDx=0;entryDy=0;" edge="1" parent="1" source="b1" target="diode"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="um" value="&lt;font style=&quot;font-size:11px&quot;&gt;monitoring · CHAT|MONITOR&lt;/font&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeWidth=2;fontSize=12;labelBackgroundColor=#ffffff;strokeWidth=3;strokeColor=#d79b00;dashed=1;dashPattern=8 4;exitX=1;exitY=0.85;exitDx=0;exitDy=0;entryX=0;entryY=0.908;entryDx=0;entryDy=0;" edge="1" parent="1" source="mon" target="diode"><mxGeometry x="0.75" relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="rz" value="HIGH SIDE: Docker containers today (k8s later)" style="rounded=1;arcSize=3;html=1;whiteSpace=wrap;dashed=1;verticalAlign=bottom;align=left;spacingLeft=14;spacingBottom=8;fontStyle=1;fontSize=15;fontColor=#33414e;fillColor=#f5f7fa;strokeColor=#9aa5b1;" vertex="1" parent="1"><mxGeometry x="910" y="100" width="1060" height="870" as="geometry"/></mxCell>
<mxCell id="rcv" value="&lt;b&gt;receivers&lt;/b&gt; &lt;font style=&quot;font-size:11px&quot;&gt;(one per room)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#e1d5e7;strokeColor=#9673a6;verticalAlign=top;spacingTop=8;fontSize=14;arcSize=3;" vertex="1" parent="1"><mxGeometry x="950" y="140" width="320" height="450" as="geometry"/></mxCell>
<mxCell id="rc" value="&lt;b&gt;CHAT|&amp;lt;ROOM&amp;gt;: chat&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;reassemble → Signal event&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="975" y="190" width="270" height="80" as="geometry"/></mxCell>
<mxCell id="rr" value="&lt;b&gt;Chat.record() → my_forward&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;simple record → Gotham Chat&lt;br&gt;per receiver (FORWARD_TO)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="975" y="310" width="270" height="90" as="geometry"/></mxCell>
<mxCell id="rcr" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeWidth=2;fontSize=12;labelBackgroundColor=#ffffff;strokeColor=#9673a6;" edge="1" parent="1" source="rc" target="rr"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="rnote" value="&lt;font style=&quot;font-size:11px&quot;&gt;Never touches the database: passes everything to the console over HTTP.&lt;br&gt;&lt;br&gt;Its counters (/stats) are its heartbeat, with: forwarded / delivered / failed, kernel drops, per sender how far it got (kept across restarts), problems by code. A watchdog thread reports a stuck loop.&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;fontColor=#4a4a4a;" vertex="1" parent="1"><mxGeometry x="975" y="420" width="270" height="150" as="geometry"/></mxCell>
<mxCell id="mrcv" value="&lt;b&gt;monitor-receiver&lt;/b&gt; &lt;font style=&quot;font-size:11px&quot;&gt;(own container)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#e1d5e7;strokeColor=#9673a6;verticalAlign=top;spacingTop=8;fontSize=14;arcSize=3;" vertex="1" parent="1"><mxGeometry x="950" y="640" width="320" height="290" as="geometry"/></mxCell>
<mxCell id="rm" value="&lt;b&gt;CHAT|MONITOR: monitoring&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;one datagram per message:&lt;br&gt;check the header → pass on&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="975" y="690" width="270" height="80" as="geometry"/></mxCell>
<mxCell id="mnote" value="&lt;font style=&quot;font-size:11px&quot;&gt;Sends its own heartbeat to the console every 30 s, so a dead monitor-receiver isn&#x27;t mistaken for the whole low side going silent.&lt;br&gt;&lt;br&gt;Restarting or changing it never touches chat.&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;fontColor=#4a4a4a;" vertex="1" parent="1"><mxGeometry x="975" y="785" width="270" height="140" as="geometry"/></mxCell>
<mxCell id="dc" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeWidth=2;fontSize=12;labelBackgroundColor=#ffffff;strokeWidth=3;strokeColor=#b85450;dashed=1;exitX=1;exitY=0.149;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="diode" target="rc"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="dm" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeWidth=2;fontSize=12;labelBackgroundColor=#ffffff;strokeWidth=3;strokeColor=#d79b00;dashed=1;dashPattern=8 4;exitX=1;exitY=0.724;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="diode" target="rm"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="pb" value="&lt;b&gt;console&lt;/b&gt; &lt;font style=&quot;font-size:11px&quot;&gt;(one container · owns the database)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#e1d5e7;strokeColor=#9673a6;verticalAlign=top;spacingTop=8;fontSize=14;arcSize=3;" vertex="1" parent="1"><mxGeometry x="1350" y="140" width="360" height="560" as="geometry"/></mxCell>
<mxCell id="p1" value="&lt;b&gt;Local login&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;users in the database, scrypt passwords,&lt;br&gt;12-hour session cookie&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="1375" y="190" width="310" height="80" as="geometry"/></mxCell>
<mxCell id="p2" value="&lt;b&gt;Group windows&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;one per Signal group + All, delivery figures, dock&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="1375" y="290" width="310" height="80" as="geometry"/></mxCell>
<mxCell id="p3" value="&lt;b&gt;The diagram&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;a box per part, room markers, Gotham boxes, bell = open incidents,&lt;br&gt;incident drawer and history, Log window, timeline&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="1375" y="390" width="310" height="80" as="geometry"/></mxCell>
<mxCell id="p4" value="&lt;b&gt;Checks and incidents&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;silence: 90 s STALE, 3 min DOWN · app codes · chat path&lt;br&gt;(sent on the low side vs rebuilt) · rules → likely cause · its own health&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="1375" y="490" width="310" height="80" as="geometry"/></mxCell>
<mxCell id="p5" value="&lt;b&gt;Cleanup&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;hourly: delete anything older than 30 days&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="1375" y="590" width="310" height="80" as="geometry"/></mxCell>
<mxCell id="hc" value="&lt;font style=&quot;font-size:11px&quot;&gt;HTTP :8091&lt;br&gt;/event /notice /stats&lt;/font&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeWidth=2;fontSize=12;labelBackgroundColor=#ffffff;strokeWidth=2;strokeColor=#9673a6;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.165;entryDx=0;entryDy=0;" edge="1" parent="1" source="rc" target="pb"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="hm" value="&lt;font style=&quot;font-size:11px&quot;&gt;HTTP :8091&lt;br&gt;/monitor &lt;/font&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeWidth=2;fontSize=12;labelBackgroundColor=#ffffff;strokeWidth=2;strokeColor=#9673a6;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.85;entryDx=0;entryDy=0;" edge="1" parent="1" source="rm" target="pb"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1305" y="730"/><mxPoint x="1305" y="616"/></Array></mxGeometry></mxCell>
<mxCell id="db" value="&lt;b&gt;high/data/relay.db&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;SQLite · chat history, monitoring&lt;br&gt;events, users, sessions&lt;br&gt;kept 30 days, survives restarts&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;size=10;fontSize=12;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="1420" y="780" width="220" height="140" as="geometry"/></mxCell>
<mxCell id="pdb" value="&lt;font style=&quot;font-size:11px&quot;&gt;read / write&lt;/font&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeWidth=2;fontSize=12;labelBackgroundColor=#ffffff;strokeWidth=2;strokeColor=#9673a6;startArrow=block;startFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="pb" target="db"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="br" value="&lt;b&gt;Browsers&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;HTTPS :8090&lt;br&gt;log in&lt;br&gt;&lt;br&gt;bell, incident drawer,&lt;br&gt;&quot;Ask Analyst&quot;&lt;br&gt;&lt;br&gt;red &quot;monitor last checked&quot;&lt;br&gt;if the console is stuck&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="1770" y="300" width="180" height="210" as="geometry"/></mxCell>
