<mxfile host="drawio" agent="signal-relay"><diagram id="d" name="Registering a new number"><mxGraphModel grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1760" pageHeight="780" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/>
<mxCell id="title" value="&lt;b&gt;Registering a new number (service account)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot; color=&quot;#555555&quot;&gt;docs/register-account.md: signal-cli becomes the number's main device; no phone needed&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=22;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1200" height="60" as="geometry"/></mxCell>
<mxCell id="a1" value="&lt;b&gt;1. Prepare&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;stop signal-cli&lt;br&gt;empty left/signal-data&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="40" y="120" width="240" height="110" as="geometry"/></mxCell>
<mxCell id="a2" value="&lt;b&gt;2. Captcha&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;solve it in a browser,&lt;br&gt;copy the signalcaptcha:// link&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="330" y="120" width="240" height="110" as="geometry"/></mxCell>
<mxCell id="ea2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeWidth=2;fontSize=12;labelBackgroundColor=#ffffff;strokeColor=#6c8ebf;" edge="1" parent="1" source="a1" target="a2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="a3" value="&lt;b&gt;3. register --voice&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;signalctl register $N&lt;br&gt;--voice --captcha …&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="620" y="120" width="240" height="110" as="geometry"/></mxCell>
<mxCell id="ea3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeWidth=2;fontSize=12;labelBackgroundColor=#ffffff;strokeColor=#6c8ebf;" edge="1" parent="1" source="a2" target="a3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="a4" value="&lt;b&gt;Landline rings&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;an automated voice&lt;br&gt;reads a 6-digit code&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="910" y="120" width="240" height="110" as="geometry"/></mxCell>
<mxCell id="ea4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeWidth=2;fontSize=12;labelBackgroundColor=#ffffff;strokeColor=#6c8ebf;" edge="1" parent="1" source="a3" target="a4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="a5" value="&lt;b&gt;4. verify&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;signalctl verify $N 123456&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="1200" y="120" width="240" height="110" as="geometry"/></mxCell>
<mxCell id="ea5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeWidth=2;fontSize=12;labelBackgroundColor=#ffffff;strokeColor=#6c8ebf;" edge="1" parent="1" source="a4" target="a5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="b1" value="&lt;b&gt;5. Registration lock&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;signalctl set-pin $N 'PIN'&lt;br&gt;store the PIN safely&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="40" y="430" width="240" height="110" as="geometry"/></mxCell>
<mxCell id="b2" value="&lt;b&gt;6. Name&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;updateProfile&lt;br&gt;--given-name &quot;Signal Relay&quot;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="330" y="430" width="240" height="110" as="geometry"/></mxCell>
<mxCell id="eb2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeWidth=2;fontSize=12;labelBackgroundColor=#ffffff;strokeColor=#6c8ebf;" edge="1" parent="1" source="b1" target="b2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="b3" value="&lt;b&gt;7. Join the group&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;joinGroup --uri (group link)&lt;br&gt;listGroups → group ID&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="620" y="430" width="240" height="110" as="geometry"/></mxCell>
<mxCell id="eb3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeWidth=2;fontSize=12;labelBackgroundColor=#ffffff;strokeColor=#6c8ebf;" edge="1" parent="1" source="b2" target="b3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="b4" value="&lt;b&gt;8. Point the relay at it&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;compose: -a number, GROUP&lt;br&gt;delete signal-last-event-id&lt;br&gt;docker compose up -d&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="910" y="430" width="240" height="110" as="geometry"/></mxCell>
<mxCell id="eb4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeWidth=2;fontSize=12;labelBackgroundColor=#ffffff;strokeColor=#6c8ebf;" edge="1" parent="1" source="b3" target="b4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="b5" value="&lt;b&gt;9. Back up&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;signal stopped, tar | gpg&lt;br&gt;keep it off the host&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="1200" y="430" width="240" height="110" as="geometry"/></mxCell>
<mxCell id="eb5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeWidth=2;fontSize=12;labelBackgroundColor=#ffffff;strokeColor=#6c8ebf;" edge="1" parent="1" source="b4" target="b5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="ewrap" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeWidth=2;fontSize=12;labelBackgroundColor=#ffffff;strokeColor=#6c8ebf;" edge="1" parent="1" source="a5" target="b1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1320" y="385"/><mxPoint x="160" y="385"/></Array></mxGeometry></mxCell>
<mxCell id="fb" value="&lt;b&gt;If register --voice fails&lt;/b&gt; (error mentions SMS or a wait):&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;request an SMS with a new captcha (a landline won't get it), wait 60 s,&lt;br&gt;then ask for the call again with another new captcha&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;dashed=1;" vertex="1" parent="1"><mxGeometry x="505" y="260" width="470" height="90" as="geometry"/></mxCell>
<mxCell id="efb" value="&lt;font style=&quot;font-size:11px&quot;&gt;error&lt;/font&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeWidth=2;fontSize=12;labelBackgroundColor=#ffffff;strokeColor=#d79b00;dashed=1;" edge="1" parent="1" source="a3" target="fb"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="acct" value="&lt;b&gt;left/signal-data&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;now holds the account&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;size=10;fontSize=12;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="1500" y="130" width="220" height="90" as="geometry"/></mxCell>
<mxCell id="eacct" value="&lt;font style=&quot;font-size:11px&quot;&gt;creates&lt;/font&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeWidth=2;fontSize=12;labelBackgroundColor=#ffffff;dashed=1;strokeColor=#d6b656;" edge="1" parent="1" source="a5" target="acct"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="rules" value="&lt;b&gt;Rules for a service account&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;• Never register the number anywhere else: a new registration logs this one out.&lt;br&gt;• Keep signal-cli running: Signal deletes accounts that stay offline for months.&lt;br&gt;• Never run two signal-cli on signal-data. Stop the signal service before any signalctl command.&lt;br&gt;• Later devices (Signal Desktop, a sender) are linked from it with addDevice --uri 'sgnl://…'.&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="590" width="1300" height="150" as="geometry"/></mxCell>
</root></mxGraphModel></diagram></mxfile>
