<mxfile host="drawio" agent="signal-relay"><diagram id="d" name="How the receiver rebuilds a message"><mxGraphModel grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="1180" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/>
<mxCell id="title" value="&lt;b&gt;How the receiver rebuilds a message&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot; color=&quot;#555555&quot;&gt;Reassembler in right/receiver/cef_to_json.py, for one message sent as 3 UDP packets&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=22;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1200" height="60" as="geometry"/></mxCell>
<mxCell id="pk0" value="&lt;font face=&quot;Courier New&quot; style=&quot;font-size:10px&quot;&gt;CEF:0|J6-DTT|CHAT|2|3|SIGNAL-RELAY|APP|&lt;br&gt;{&quot;s&quot;:&quot;9f3a1c22&quot;,&quot;q&quot;:42,&quot;m&quot;:17,&lt;br&gt;&quot;i&quot;:2,&quot;n&quot;:3,&quot;d&quot;:&quot;…rceName…&quot;}&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffffff;strokeColor=#b85450;dashed=1;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="40" y="120" width="330" height="80" as="geometry"/></mxCell>
<mxCell id="pk1" value="&lt;font face=&quot;Courier New&quot; style=&quot;font-size:10px&quot;&gt;CEF:0|J6-DTT|CHAT|1|3|SIGNAL-RELAY|APP|&lt;br&gt;{&quot;s&quot;:&quot;9f3a1c22&quot;,&quot;q&quot;:41,&quot;m&quot;:17,&lt;br&gt;&quot;i&quot;:1,&quot;n&quot;:3,&quot;d&quot;:&quot;{\&quot;envel…&quot;}&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffffff;strokeColor=#b85450;dashed=1;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="40" y="220" width="330" height="80" as="geometry"/></mxCell>
<mxCell id="pk2" value="&lt;font face=&quot;Courier New&quot; style=&quot;font-size:10px&quot;&gt;CEF:0|J6-DTT|CHAT|3|3|SIGNAL-RELAY|APP|&lt;br&gt;{&quot;s&quot;:&quot;9f3a1c22&quot;,&quot;q&quot;:43,&quot;m&quot;:17,&lt;br&gt;&quot;i&quot;:3,&quot;n&quot;:3,&quot;d&quot;:&quot;…ham\&quot;}}}&quot;}&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffffff;strokeColor=#b85450;dashed=1;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="40" y="320" width="330" height="80" as="geometry"/></mxCell>
<mxCell id="pkn" value="&lt;font style=&quot;font-size:11px&quot;&gt;&lt;b&gt;s&lt;/b&gt; session: new each time the subscriber starts&lt;br&gt;&lt;b&gt;q&lt;/b&gt; packet number in the session&lt;br&gt;&lt;b&gt;m&lt;/b&gt; message number&lt;br&gt;&lt;b&gt;i / n&lt;/b&gt; this part / how many parts&lt;br&gt;&lt;b&gt;d&lt;/b&gt; a slice of the JSON text (not valid JSON on its own)&lt;br&gt;&lt;br&gt;Packets can arrive in any order.&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="420" width="330" height="150" as="geometry"/></mxCell>
<mxCell id="f1" value="① &lt;b&gt;parse&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;parse_string_in_cef(): header tag + {s,q,m,i,n,d}&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="520" y="110" width="320" height="75" as="geometry"/></mxCell>
<mxCell id="f2" value="② seen (s, q)&lt;br&gt;before?" style="rhombus;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="520" y="230" width="320" height="110" as="geometry"/></mxCell>
<mxCell id="f3" value="③ &lt;b&gt;check for gaps&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;next expected q for this session&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="520" y="385" width="320" height="75" as="geometry"/></mxCell>
<mxCell id="f4" value="④ &lt;b&gt;collect&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;pending[(s, m)].parts[i] = d&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="520" y="505" width="320" height="75" as="geometry"/></mxCell>
<mxCell id="f5" value="⑤ all n&lt;br&gt;parts here?" style="rhombus;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="520" y="625" width="320" height="110" as="geometry"/></mxCell>
<mxCell id="f6" value="&lt;b&gt;join in order 1…n, then json.loads()&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;arrival order doesn't matter&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="520" y="780" width="320" height="75" as="geometry"/></mxCell>
<mxCell id="f7" value="&lt;b&gt;the original signal-cli event&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="520" y="900" width="320" height="75" as="geometry"/></mxCell>
<mxCell id="ef1f2" value="valid" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeWidth=2;fontSize=12;labelBackgroundColor=#ffffff;strokeColor=#9673a6;" edge="1" parent="1" source="f1" target="f2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="ef2f3" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeWidth=2;fontSize=12;labelBackgroundColor=#ffffff;strokeColor=#9673a6;" edge="1" parent="1" source="f2" target="f3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="ef3f4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeWidth=2;fontSize=12;labelBackgroundColor=#ffffff;strokeColor=#9673a6;" edge="1" parent="1" source="f3" target="f4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="ef4f5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeWidth=2;fontSize=12;labelBackgroundColor=#ffffff;strokeColor=#9673a6;" edge="1" parent="1" source="f4" target="f5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="ef5f6" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeWidth=2;fontSize=12;labelBackgroundColor=#ffffff;strokeColor=#9673a6;" edge="1" parent="1" source="f5" target="f6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="ef6f7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeWidth=2;fontSize=12;labelBackgroundColor=#ffffff;strokeColor=#9673a6;" edge="1" parent="1" source="f6" target="f7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="r1" value="&lt;b&gt;ignored:&lt;/b&gt; not a valid relay packet&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;bad CEF, tag ≠ SIGNAL-RELAY, or not 1 ≤ i ≤ n&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="960" y="112.5" width="330" height="70" as="geometry"/></mxCell>
<mxCell id="r2" value="&lt;b&gt;ignored:&lt;/b&gt; duplicate packet" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="960" y="255.0" width="330" height="60" as="geometry"/></mxCell>
<mxCell id="r3" value="&lt;b&gt;log:&lt;/b&gt; &quot;1 packet(s) never arrived (#43)&quot;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;then carry on&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="960" y="387.5" width="330" height="70" as="geometry"/></mxCell>
<mxCell id="r5" value="&lt;b&gt;wait&lt;/b&gt; for the rest&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;up to 30 s, then give up:&lt;br&gt;log + &quot;a message was lost&quot; notice to playback&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="960" y="635.0" width="330" height="90" as="geometry"/></mxCell>
<mxCell id="er1" value="bad" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeWidth=2;fontSize=12;labelBackgroundColor=#ffffff;strokeColor=#b85450;" edge="1" parent="1" source="f1" target="r1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="er2" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeWidth=2;fontSize=12;labelBackgroundColor=#ffffff;strokeColor=#b85450;" edge="1" parent="1" source="f2" target="r2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="er3" value="q skipped" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeWidth=2;fontSize=12;labelBackgroundColor=#ffffff;strokeColor=#d79b00;dashed=1;" edge="1" parent="1" source="f3" target="r3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="er5" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeWidth=2;fontSize=12;labelBackgroundColor=#ffffff;strokeColor=#d79b00;" edge="1" parent="1" source="f5" target="r5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="rec" value="&lt;b&gt;Chat.record(event)&lt;/b&gt; → my_forward(record)&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;simple record for the external platform&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="300" y="1027.5" width="300" height="75" as="geometry"/></mxCell>
<mxCell id="dlv" value="&lt;b&gt;deliver(event)&lt;/b&gt; → playback&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;later: Palantir&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="760" y="1027.5" width="300" height="75" as="geometry"/></mxCell>
<mxCell id="erec" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeWidth=2;fontSize=12;labelBackgroundColor=#ffffff;strokeColor=#d6b656;" edge="1" parent="1" source="f7" target="rec"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="edlv" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeWidth=2;fontSize=12;labelBackgroundColor=#ffffff;strokeColor=#9673a6;" edge="1" parent="1" source="f7" target="dlv"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="epk0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeWidth=2;fontSize=12;labelBackgroundColor=#ffffff;strokeWidth=3;strokeColor=#b85450;dashed=1;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="pk0" target="f1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="450" y="160"/><mxPoint x="450" y="147"/></Array></mxGeometry></mxCell>
<mxCell id="epk1" value="UDP 6510" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeWidth=2;fontSize=12;labelBackgroundColor=#ffffff;strokeWidth=3;strokeColor=#b85450;dashed=1;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="pk1" target="f1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="450" y="260"/><mxPoint x="450" y="147"/></Array></mxGeometry></mxCell>
<mxCell id="epk2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeWidth=2;fontSize=12;labelBackgroundColor=#ffffff;strokeWidth=3;strokeColor=#b85450;dashed=1;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="pk2" target="f1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="450" y="360"/><mxPoint x="450" y="147"/></Array></mxGeometry></mxCell>
<mxCell id="lim" value="&lt;font style=&quot;font-size:11px&quot;&gt;&lt;b&gt;Limits&lt;/b&gt;&lt;br&gt;• at most 1,000 messages waiting at once (oldest dropped)&lt;br&gt;• at most 2,000 parts per message&lt;br&gt;• key is (s, m): after a restart m starts again, but s is new&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=12;" vertex="1" parent="1"><mxGeometry x="960" y="777.5" width="400" height="120" as="geometry"/></mxCell>
</root></mxGraphModel></diagram></mxfile>
