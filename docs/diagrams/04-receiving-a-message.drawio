<mxfile host="drawio" agent="signal-relay"><diagram id="d" name="Receiving a message"><mxGraphModel grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1060" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/>
<mxCell id="title" value="&lt;b&gt;How signal-cli receives a message&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot; color=&quot;#555555&quot;&gt;From the sender's phone to one JSON event for the subscriber&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=22;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1200" height="60" as="geometry"/></mxCell>
<mxCell id="phone" value="&lt;b&gt;Sender's phone&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;a group member&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="40" y="130" width="220" height="80" as="geometry"/></mxCell>
<mxCell id="srv" value="&lt;b&gt;Signal server&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;holds only encrypted envelopes&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#eef3f8;strokeColor=#6c8ebf;verticalAlign=top;spacingTop=8;fontSize=14;arcSize=4;" vertex="1" parent="1"><mxGeometry x="40" y="290" width="360" height="330" as="geometry"/></mxCell>
<mxCell id="q1" value="queue: our other device (phone or Desktop)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="70" y="370" width="300" height="55" as="geometry"/></mxCell>
<mxCell id="q2" value="queue: another device" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffffff;strokeColor=#6c8ebf;dashed=1;" vertex="1" parent="1"><mxGeometry x="70" y="445" width="300" height="55" as="geometry"/></mxCell>
<mxCell id="q3" value="&lt;b&gt;queue: signal-cli&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;its own encrypted copy&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="70" y="520" width="300" height="70" as="geometry"/></mxCell>
<mxCell id="e_ph" value="encrypts a separate copy&lt;br&gt;for every device on our account" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeWidth=2;fontSize=12;labelBackgroundColor=#ffffff;strokeColor=#6c8ebf;" edge="1" parent="1" source="phone" target="srv"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="sc" value="&lt;b&gt;signal-cli&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;verticalAlign=top;spacingTop=8;fontSize=14;arcSize=3;" vertex="1" parent="1"><mxGeometry x="640" y="120" width="560" height="790" as="geometry"/></mxCell>
<mxCell id="s1" value="① &lt;b&gt;takes the envelope&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;still encrypted; the sender is often hidden (sealed sender)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="680" y="170" width="480" height="85" as="geometry"/></mxCell>
<mxCell id="s2" value="② &lt;b&gt;libsignal decrypts it&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;with the session for that sender, then moves the session forward&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="680" y="290" width="480" height="85" as="geometry"/></mxCell>
<mxCell id="es1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeWidth=2;fontSize=12;labelBackgroundColor=#ffffff;strokeColor=#6c8ebf;" edge="1" parent="1" source="s1" target="s2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="s3" value="③ &lt;b&gt;confirms it to the server&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;the server deletes its copy&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="680" y="410" width="480" height="85" as="geometry"/></mxCell>
<mxCell id="es2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeWidth=2;fontSize=12;labelBackgroundColor=#ffffff;strokeColor=#6c8ebf;" edge="1" parent="1" source="s2" target="s3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="s4" value="④ &lt;b&gt;sends a delivery receipt&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;the second tick, to the sender; on by default&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="680" y="530" width="480" height="85" as="geometry"/></mxCell>
<mxCell id="es3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeWidth=2;fontSize=12;labelBackgroundColor=#ffffff;strokeColor=#6c8ebf;" edge="1" parent="1" source="s3" target="s4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="s5" value="⑤ &lt;b&gt;updates its database&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;session, the contact's profile key, group state if it changed&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="680" y="650" width="480" height="85" as="geometry"/></mxCell>
<mxCell id="es4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeWidth=2;fontSize=12;labelBackgroundColor=#ffffff;strokeColor=#6c8ebf;" edge="1" parent="1" source="s4" target="s5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="s6" value="⑥ &lt;b&gt;outputs one JSON event&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;kept in memory for the event stream&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="680" y="770" width="480" height="85" as="geometry"/></mxCell>
<mxCell id="es5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeWidth=2;fontSize=12;labelBackgroundColor=#ffffff;strokeColor=#6c8ebf;" edge="1" parent="1" source="s5" target="s6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="e_push" value="pushed down&lt;br&gt;the WebSocket" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeWidth=2;fontSize=12;labelBackgroundColor=#ffffff;strokeColor=#6c8ebf;" edge="1" parent="1" source="q3" target="s1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="500" y="555"/><mxPoint x="500" y="212"/></Array></mxGeometry></mxCell>
<mxCell id="e_ack" value="&lt;font style=&quot;font-size:11px&quot;&gt;confirm&lt;/font&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeWidth=2;fontSize=12;labelBackgroundColor=#ffffff;dashed=1;strokeColor=#d79b00;entryX=1;entryY=0.49;entryDx=0;entryDy=0;" edge="1" parent="1" source="s3" target="srv"><mxGeometry x="0.6" relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="e_rcpt" value="&lt;font style=&quot;font-size:11px&quot;&gt;receipt, via the server&lt;/font&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeWidth=2;fontSize=12;labelBackgroundColor=#ffffff;dashed=1;strokeColor=#d79b00;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="s4" target="phone"><mxGeometry x="0.4" relative="1" as="geometry"><Array as="points"><mxPoint x="1230" y="572"/><mxPoint x="1230" y="100"/><mxPoint x="150" y="100"/></Array></mxGeometry></mxCell>
<mxCell id="db" value="&lt;b&gt;account.db&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;in low/signal-data&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;size=10;fontSize=12;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="1270" y="750" width="200" height="90" as="geometry"/></mxCell>
<mxCell id="e_db" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeWidth=2;fontSize=12;labelBackgroundColor=#ffffff;dashed=1;strokeColor=#d6b656;" edge="1" parent="1" source="s5" target="db"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1370" y="692"/></Array></mxGeometry></mxCell>
<mxCell id="sub" value="&lt;b&gt;subscriber&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;reads it over the event stream (SSE)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="1270" y="900" width="260" height="80" as="geometry"/></mxCell>
<mxCell id="e_sub" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeWidth=2;fontSize=12;labelBackgroundColor=#ffffff;strokeWidth=4;strokeColor=#2f5597;" edge="1" parent="1" source="s6" target="sub"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1220" y="812"/><mxPoint x="1220" y="940"/></Array></mxGeometry></mxCell>
<mxCell id="lg1" value="" style="html=1;endArrow=block;strokeWidth=2;dashed=1;strokeColor=#d79b00;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="40" y="700" as="sourcePoint"/><mxPoint x="100" y="700" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="lt1" value="&lt;font style=&quot;font-size:11px&quot;&gt;sent back to Signal: no message content&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=12;" vertex="1" parent="1"><mxGeometry x="110" y="685" width="400" height="30" as="geometry"/></mxCell>
<mxCell id="n1" value="&lt;font style=&quot;font-size:11px&quot;&gt;&lt;b&gt;Sessions&lt;/b&gt; move forward with every message (the double ratchet). An old copy of the database cannot read new messages, and two processes on one database break each other.&lt;br&gt;&lt;br&gt;&lt;b&gt;Your own messages&lt;/b&gt; sent from another of the account's devices arrive as a syncMessage, not a dataMessage.&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="740" width="560" height="180" as="geometry"/></mxCell>
</root></mxGraphModel></diagram></mxfile>
