# Secrets and live data are never committed. The folders themselves are kept (each has a .gitkeep), so a fresh
# clone has the layout the compose files expect; fill them as described in high/docs/low-side.md and high/docs/high-side.md.

# Signal account keys
low/signal-data/*
!low/signal-data/.gitkeep
# our CA (ca.key): stays on the build host
certs/*/*
!certs/*/.gitkeep
# signal-cli and subscriber TLS keys (make with image/tlscerts)
low/certs/*/*
!low/certs/*/.gitkeep
# *.lab.int certificate and key for the chat page
high/console/certs/*
!high/console/certs/.gitkeep
# stream position and copies of sent messages (message content)
low/logs/*
!low/logs/.gitkeep
high/logs/*
!high/logs/.gitkeep
# the console's database: chat history (message content), monitoring, users and sessions
high/data/*
!high/data/.gitkeep
# real messages
tools/signal-sample.jsonl
# archives of all of the above
backup/
*.key
__pycache__/
# saved image archives (docker image save), too big for git
image/*.tar
image/*.tar.sha256
# API keys for the AI assistant (dev)
.env
