# Secrets and live data are never committed. The folders themselves are kept (each has a .gitkeep), so a fresh
# clone has the layout the compose files expect; fill them as described in left/README.md and right/README.md.

# Signal account keys
left/signal-data/*
!left/signal-data/.gitkeep
# our CA (ca.key): stays on the build host
certs/*/*
!certs/*/.gitkeep
# signal-cli and subscriber TLS keys (make with image/tlscerts)
left/certs/*/*
!left/certs/*/.gitkeep
# *.lab.int certificate and key for the chat page
right/playback/certs/*
!right/playback/certs/.gitkeep
# stream position and copies of sent messages (message content)
left/logs/*
!left/logs/.gitkeep
right/logs/*
!right/logs/.gitkeep
# playback's database: chat history (message content), monitoring, users and sessions
right/data/*
!right/data/.gitkeep
# real messages
tools/signal-sample.jsonl
# archives of all of the above
backup/
*.key
__pycache__/
# saved image archives (docker image save), too big for git
image/*.tar
image/*.tar.sha256
# API keys for the AI assistant (dev)
.env
